{
  "Repositories": [
    { "Owner": "microsoft", "Name": "winget-cli", "Enabled": true },
    { "Owner": "microsoft", "Name": "PowerToys", "Enabled": false },
    { "Owner": "microsoft", "Name": "vscode", "Enabled": false }
  ],
  "Ingestion": {
    "InitialHistoryDays": 90,
    "MaxRejectedPercent": 10,
    "RateLimitMaxWaitMinutes": 15
  },
  "Operations": {
    "SqlStartupWaitSeconds": 120
  },
  "Privacy": {
    "AnalyzerUrl": "http://localhost:5002",
    "AnonymizerUrl": "http://localhost:5001",
    "ScoreThreshold": 0.5
  },
  "Text": {
    "BodyMaxCharacters": 4000
  },
  "Publishing": {
    "OutputDirectory": "out/site"
  }
}
